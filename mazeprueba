#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_TCS34725.h>
#include <math.h>

// ========================================
// ROBOREGOS - PISTA B
// BUSQUEDA RAPIDA + MEMORIA APROXIMADA
// IR EN EL LADO IZQUIERDO
// ========================================

// ---------- MOTORES TB6612FNG ----------

const int PWMA = 5;
const int AIN1 = A0;
const int AIN2 = A1;

const int PWMB = 6;
const int BIN1 = A2;
const int BIN2 = A3;

const int STBY = 11;

// ---------- SENSORES ----------

const int TRIGGER_PIN = 2;
const int ECHO_PIN = 4;

// Sensor infrarrojo izquierdo
const int IR_IZQUIERDO = 7;

// Muchos modulos IR digitales entregan LOW al detectar.
// Verifica este comportamiento con tu sensor.
const int IR_PARED = LOW;

// ---------- LEDS ----------

const int pink_pin = 9;
const int orange_pin = 10;
const int yellow_pin = 3;
const int blue_pin = 12;

// ---------- SENSOR RGB ----------

Adafruit_TCS34725 tcs(
  TCS34725_INTEGRATIONTIME_60MS,
  TCS34725_GAIN_1X
);

// ========================================
// CONFIGURACION
// ========================================

const int VELOCIDAD = 210;
const int VELOCIDAD_GIRO = 220;
const int VELOCIDAD_RETROCESO = 160;

const bool INVERTIR_IZQUIERDO = true;
const bool INVERTIR_DERECHO = true;

// Ajusta estos tiempos segun las pruebas fisicas.
const unsigned long TIEMPO_CASILLA = 4000;
const unsigned long TIEMPO_GIRO_90 = 2000;
const unsigned long TIEMPO_GIRO_30 = 667;
const unsigned long TIEMPO_RETROCESO = 300;

const float DISTANCIA_PARED = 15.0;
const float DISTANCIA_LIBRE = 20.0;
const float DISTANCIA_ABERTURA = 25.0;

const unsigned long INTERVALO_ULTRASONICO = 60;
const unsigned long INTERVALO_RGB = 500;

// ========================================
// MEMORIA
// ========================================

const int MAPA_SIZE = 15;

byte visitadas[MAPA_SIZE][MAPA_SIZE];

int posX = MAPA_SIZE / 2;
int posY = MAPA_SIZE / 2;

// 0 = NORTE, 1 = ESTE, 2 = SUR, 3 = OESTE
int orientacion = 0;

const int dx[4] = {0, 1, 0, -1};
const int dy[4] = {-1, 0, 1, 0};

// ========================================
// VARIABLES
// ========================================

float distancia = -1;

bool colorDisponible = false;

float rojo = 0;
float verde = 0;
float azul = 0;

unsigned long ultimaLecturaRGB = 0;

// ========================================
// MOTORES
// ========================================

void moverMotores(int izquierda, int derecha) {
  izquierda = constrain(izquierda, -255, 255);
  derecha = constrain(derecha, -255, 255);

  if (INVERTIR_IZQUIERDO) izquierda = -izquierda;
  if (INVERTIR_DERECHO) derecha = -derecha;

  digitalWrite(AIN1, izquierda > 0 ? HIGH : LOW);
  digitalWrite(AIN2, izquierda < 0 ? HIGH : LOW);

  digitalWrite(BIN1, derecha > 0 ? HIGH : LOW);
  digitalWrite(BIN2, derecha < 0 ? HIGH : LOW);

  analogWrite(PWMA, abs(izquierda));
  analogWrite(PWMB, abs(derecha));
}

void detener() {
  moverMotores(0, 0);
}

void avanzar() {
  moverMotores(VELOCIDAD, VELOCIDAD);
}

void retroceder() {
  moverMotores(-VELOCIDAD_RETROCESO, -VELOCIDAD_RETROCESO);
}

void girarDerecha() {
  moverMotores(VELOCIDAD_GIRO, -VELOCIDAD_GIRO);
}

void girarIzquierda() {
  moverMotores(-VELOCIDAD_GIRO, VELOCIDAD_GIRO);
}

// ========================================
// SENSORES
// ========================================

void leerUltrasonico() {
  digitalWrite(TRIGGER_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIGGER_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIGGER_PIN, LOW);

  unsigned long tiempo = pulseIn(ECHO_PIN, HIGH, 25000UL);

  if (tiempo == 0) {
    distancia = -1;
  } else {
    distancia = tiempo * 0.0343 / 2.0;
  }
}

bool paredIzquierda() {
  return digitalRead(IR_IZQUIERDO) == IR_PARED;
}

bool espacioLibre(float minimo) {
  leerUltrasonico();

  // Una lectura invalida NO significa que el camino este libre.
  return distancia >= minimo;
}

// ========================================
// LEDS Y SENSOR RGB
// ========================================

void apagarLeds() {
  digitalWrite(pink_pin, LOW);
  digitalWrite(orange_pin, LOW);
  digitalWrite(yellow_pin, LOW);
  digitalWrite(blue_pin, LOW);
}

void leerColor() {
  if (!colorDisponible) {
    apagarLeds();
    return;
  }

  uint16_t r, g, b, c;
  tcs.getRawData(&r, &g, &b, &c);

  if (c == 0) {
    apagarLeds();
    return;
  }

  rojo = (float)r / c;
  verde = (float)g / c;
  azul = (float)b / c;

  apagarLeds();

  // ROSA
  if (rojo > verde * 1.20 &&
      rojo > azul * 1.10 &&
      azul > verde * 0.85) {
    digitalWrite(pink_pin, HIGH);
  }

  // AMARILLO
  else if (rojo > azul * 1.35 &&
           verde > azul * 1.35 &&
           fabs(rojo - verde) < 0.20 &&
           verde > 0.20) {
    digitalWrite(yellow_pin, HIGH);
  }

  // NARANJA
  else if (rojo > verde * 1.30 &&
           verde > azul * 1.15 &&
           verde > 0.15) {
    digitalWrite(orange_pin, HIGH);
  }

  // CELESTE
  else if (azul > rojo * 1.20 &&
           verde > rojo * 1.10) {
    digitalWrite(blue_pin, HIGH);
  }
}

void actualizarRGB() {
  if (millis() - ultimaLecturaRGB >= INTERVALO_RGB) {
    ultimaLecturaRGB = millis();
    leerColor();
  }
}

// ========================================
// MEMORIA DE CASILLAS
// ========================================

bool posicionValida(int x, int y) {
  return x >= 0 && x < MAPA_SIZE &&
         y >= 0 && y < MAPA_SIZE;
}

byte vecesVisitada(int direccion) {
  int nx = posX + dx[direccion];
  int ny = posY + dy[direccion];

  if (!posicionValida(nx, ny)) {
    return 255;
  }

  return visitadas[ny][nx];
}

void registrarCasilla() {
  if (!posicionValida(posX, posY)) return;

  if (visitadas[posY][posX] < 254) {
    visitadas[posY][posX]++;
  }

  Serial.print("POSICION: ");
  Serial.print(posX);
  Serial.print(",");
  Serial.println(posY);
}

void actualizarPosicion() {
  int nx = posX + dx[orientacion];
  int ny = posY + dy[orientacion];

  if (posicionValida(nx, ny)) {
    posX = nx;
    posY = ny;
    registrarCasilla();
  } else {
    Serial.println("LIMITE DEL MAPA");
  }
}

// ========================================
// GIROS
// ========================================

void girarPasoDerecha() {
  girarDerecha();
  delay(TIEMPO_GIRO_30);
  detener();
  delay(100);
}

void girarPasoIzquierda() {
  girarIzquierda();
  delay(TIEMPO_GIRO_30);
  detener();
  delay(100);
}

void girar90Derecha() {
  girarDerecha();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 1) % 4;
}

void girar90Izquierda() {
  girarIzquierda();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 3) % 4;
}

void girar180() {
  girar90Derecha();
  girar90Derecha();
}

// ========================================
// RETROCEDER Y GIRAR
// ========================================

void retrocederYGirarDerecha() {
  detener();
  retroceder();
  delay(TIEMPO_RETROCESO);
  detener();
  delay(100);

  girar90Derecha();
}

void retrocederYGirarIzquierda() {
  detener();
  retroceder();
  delay(TIEMPO_RETROCESO);
  detener();
  delay(100);

  girar90Izquierda();
}

// ========================================
// AVANZAR UNA CASILLA
// ========================================

bool avanzarCasilla() {
  unsigned long inicio = millis();
  unsigned long ultimaRevision = 0;

  avanzar();

  while (millis() - inicio < TIEMPO_CASILLA) {
    unsigned long ahora = millis();

    actualizarRGB();

    // El IR izquierdo puede detectar una pared lateral.
    // Se detiene y se deja que la navegacion decida el giro.
    if (paredIzquierda()) {
      detener();
      Serial.println("PARED IR IZQUIERDA");
      return false;
    }

    if (ahora - ultimaRevision >= INTERVALO_ULTRASONICO) {
      ultimaRevision = ahora;
      leerUltrasonico();

      if (distancia < 0 || distancia <= DISTANCIA_PARED) {
        detener();
        Serial.println("OBSTACULO FRONTAL O ERROR ULTRASONICO");
        return false;
      }
    }
  }

  detener();
  actualizarPosicion();

  return true;
}

// ========================================
// ESCANEO DE ABERTURAS
// ========================================

bool escanearDerecha() {
  Serial.println("BUSCANDO DERECHA");

  int pasos = 0;
  bool aberturaDetectada = false;

  for (int i = 0; i < 3; i++) {
    girarPasoDerecha();
    pasos++;

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      aberturaDetectada = true;
      break;
    }
  }

  if (aberturaDetectada) {
    while (pasos < 3) {
      girarPasoDerecha();
      pasos++;
    }

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      orientacion = (orientacion + 1) % 4;
      Serial.println("SALIDA DERECHA");
      return true;
    }
  }

  for (int i = 0; i < pasos; i++) {
    girarPasoIzquierda();
  }

  detener();
  return false;
}

bool escanearIzquierda() {
  Serial.println("BUSCANDO IZQUIERDA");

  int pasos = 0;
  bool aberturaDetectada = false;

  for (int i = 0; i < 3; i++) {
    girarPasoIzquierda();
    pasos++;

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      aberturaDetectada = true;
      break;
    }
  }

  if (aberturaDetectada) {
    while (pasos < 3) {
      girarPasoIzquierda();
      pasos++;
    }

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      orientacion = (orientacion + 3) % 4;
      Serial.println("SALIDA IZQUIERDA");
      return true;
    }
  }

  for (int i = 0; i < pasos; i++) {
    girarPasoDerecha();
  }

  detener();
  return false;
}

// ========================================
// BUSCAR SALIDA
// ========================================

bool buscarSalidaRapida() {
  detener();

  // Si el IR izquierdo detecta pared,
  // priorizar buscar hacia la derecha.
  if (paredIzquierda()) {
    Serial.println("IR IZQUIERDO: PARED");
    if (escanearDerecha()) return true;
    if (escanearIzquierda()) return true;
  } else {
    if (escanearDerecha()) return true;
    if (escanearIzquierda()) return true;
  }

  Serial.println("BUSCANDO ATRAS");

  girar180();

  if (espacioLibre(DISTANCIA_LIBRE)) {
    Serial.println("CAMINO HACIA ATRAS DETECTADO");
    return true;
  }

  Serial.println("SIN SALIDA CONFIRMADA");
  detener();
  return false;
}

// ========================================
// NAVEGACION PISTA B
// ========================================

void explorarPistaB() {
  actualizarRGB();

  // Si el sensor izquierdo detecta una pared,
  // buscar primero una salida a la derecha.
  if (paredIzquierda()) {
    detener();
    Serial.println("PARED IZQUIERDA DETECTADA");

    if (escanearDerecha()) {
      avanzarCasilla();
    } else if (escanearIzquierda()) {
      avanzarCasilla();
    } else {
      Serial.println("NO SE DETECTO ABERTURA");
      detener();
      delay(300);
    }

    return;
  }

  leerUltrasonico();

  if (distancia < 0) {
    detener();
    Serial.println("SIN LECTURA ULTRASONICA");
    delay(100);
    return;
  }

  if (distancia >= DISTANCIA_LIBRE &&
      vecesVisitada(orientacion) == 0) {
    Serial.println("AVANZANDO");
    avanzarCasilla();
    return;
  }

  detener();
  Serial.println("BUSCANDO NUEVA RUTA");

  if (buscarSalidaRapida()) {
    avanzarCasilla();
  } else {
    detener();
    delay(300);
  }
}

// ========================================
// SETUP
// ========================================

void setup() {
  Serial.begin(9600);

  pinMode(PWMA, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);

  pinMode(PWMB, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  pinMode(STBY, OUTPUT);

  pinMode(TRIGGER_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_IZQUIERDO, INPUT);

  pinMode(pink_pin, OUTPUT);
  pinMode(orange_pin, OUTPUT);
  pinMode(yellow_pin, OUTPUT);
  pinMode(blue_pin, OUTPUT);

  digitalWrite(TRIGGER_PIN, LOW);
  digitalWrite(STBY, LOW);

  detener();
  apagarLeds();

  for (int y = 0; y < MAPA_SIZE; y++) {
    for (int x = 0; x < MAPA_SIZE; x++) {
      visitadas[y][x] = 0;
    }
  }

  registrarCasilla();

  Wire.begin();
  colorDisponible = tcs.begin();

  Serial.println(
    colorDisponible ? "RGB LISTO" : "RGB NO DETECTADO"
  );

  digitalWrite(STBY, HIGH);

  Serial.println("PISTA B - BUSQUEDA RAPIDA");
  Serial.println("IR IZQUIERDO ACTIVO EN PIN 7");
  Serial.println("INICIANDO EN 3 SEGUNDOS");

  delay(3000);
}

// ========================================
// LOOP
// ========================================

void loop() {
  explorarPistaB();
}
