
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_TCS34725.h>

// ========================================
// ROBOREGOS - PISTA B
// BUSQUEDA RAPIDA + MEMORIA APROXIMADA
// ========================================

// ---------- MOTORES TB6612FNG ----------

const int PWMA = 5;
const int AIN1 = A0;
const int AIN2 = A1;

const int PWMB = 6;
const int BIN1 = A2;
const int BIN2 = A3;

const int STBY = 11;

// ---------- SENSORES ----------

const int TRIGGER_PIN = 2;
const int ECHO_PIN = 4;
const int IR_PIN = 7;

// ---------- LEDS ----------

const int pink_pin = 9;
const int orange_pin = 10;
const int yellow_pin = 3;
const int blue_pin = 12;

// ---------- SENSOR RGB ----------

Adafruit_TCS34725 tcs(
  TCS34725_INTEGRATIONTIME_60MS,
  TCS34725_GAIN_1X
);

// ========================================
// CONFIGURACION
// ========================================

const int VELOCIDAD = 210;
const int VELOCIDAD_GIRO = 220;

// NO CAMBIAR: ambos motores ya calibrados
const bool INVERTIR_IZQUIERDO = true;
const bool INVERTIR_DERECHO = true;

// 30 cm aproximadamente
const unsigned long TIEMPO_CASILLA = 4000;

// Giro de 90 grados calibrado
const unsigned long TIEMPO_GIRO_90 = 2000;

// Giro de 30 grados estimado
const unsigned long TIEMPO_GIRO_30 = 667;

// Distancias en centimetros
const float DISTANCIA_PARED = 15.0;
const float DISTANCIA_LIBRE = 20.0;

// Para aceptar una abertura en un escaneo
const float DISTANCIA_ABERTURA = 25.0;

// Intervalos
const unsigned long INTERVALO_ULTRASONICO = 60;
const unsigned long INTERVALO_RGB = 500;

// ========================================
// MEMORIA
// ========================================

const int MAPA_SIZE = 15;

byte visitadas[MAPA_SIZE][MAPA_SIZE];

// Posicion inicial
int posX = MAPA_SIZE / 2;
int posY = MAPA_SIZE / 2;

// Orientacion:
// 0 = NORTE
// 1 = ESTE
// 2 = SUR
// 3 = OESTE

int orientacion = 0;

const int dx[4] = {0, 1, 0, -1};
const int dy[4] = {-1, 0, 1, 0};

// ========================================
// VARIABLES
// ========================================

float distancia = -1;

bool colorDisponible = false;

float rojo = 0;
float verde = 0;
float azul = 0;

unsigned long ultimaLecturaRGB = 0;

// ========================================
// MOTORES
// ========================================

void moverMotores(int izquierda, int derecha) {

  izquierda = constrain(izquierda, -255, 255);
  derecha = constrain(derecha, -255, 255);

  if (INVERTIR_IZQUIERDO) {
    izquierda = -izquierda;
  }

  if (INVERTIR_DERECHO) {
    derecha = -derecha;
  }

  digitalWrite(AIN1, izquierda > 0 ? HIGH : LOW);
  digitalWrite(AIN2, izquierda < 0 ? HIGH : LOW);

  digitalWrite(BIN1, derecha > 0 ? HIGH : LOW);
  digitalWrite(BIN2, derecha < 0 ? HIGH : LOW);

  analogWrite(PWMA, abs(izquierda));
  analogWrite(PWMB, abs(derecha));
}

void detener() {
  moverMotores(0, 0);
}

void avanzar() {
  moverMotores(VELOCIDAD, VELOCIDAD);
}

void retroceder() {
  moverMotores(-VELOCIDAD, -VELOCIDAD);
}

void girarDerecha() {
  moverMotores(VELOCIDAD_GIRO, -VELOCIDAD_GIRO);
}

void girarIzquierda() {
  moverMotores(-VELOCIDAD_GIRO, VELOCIDAD_GIRO);
}

// ========================================
// ULTRASONICO
// ========================================

void leerUltrasonico() {

  digitalWrite(TRIGGER_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIGGER_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIGGER_PIN, LOW);

  unsigned long tiempo =
    pulseIn(ECHO_PIN, HIGH, 25000UL);

  if (tiempo == 0) {
    distancia = -1;
  } else {
    distancia = tiempo * 0.0343 / 2.0;
  }
}

bool espacioLibre(float minimo) {

  leerUltrasonico();

  return distancia >= minimo;
}

// ========================================
// RGB Y LEDS
// ========================================

void apagarLeds() {

  digitalWrite(pink_pin, LOW);
  digitalWrite(orange_pin, LOW);
  digitalWrite(yellow_pin, LOW);
  digitalWrite(blue_pin, LOW);
}

void leerColor() {

  if (!colorDisponible) {
    apagarLeds();
    return;
  }

  uint16_t r, g, b, c;

  tcs.getRawData(&r, &g, &b, &c);

  if (c == 0) {
    apagarLeds();
    return;
  }

  rojo = (float)r / c;
  verde = (float)g / c;
  azul = (float)b / c;

  apagarLeds();

  // ROSA
  if (rojo > verde * 1.20 &&
      rojo > azul * 1.10 &&
      azul > verde * 0.85) {

    digitalWrite(pink_pin, HIGH);
  }

  // AMARILLO
  else if (rojo > azul * 1.35 &&
           verde > azul * 1.35 &&
           fabs(rojo - verde) < 0.20 &&
           verde > 0.20) {

    digitalWrite(yellow_pin, HIGH);
  }

  // NARANJA
  else if (rojo > verde * 1.30 &&
           verde > azul * 1.15 &&
           verde > 0.15) {

    digitalWrite(orange_pin, HIGH);
  }

  // CELESTE
  else if (azul > rojo * 1.20 &&
           verde > rojo * 1.10) {

    digitalWrite(blue_pin, HIGH);
  }
}

void actualizarRGB() {

  if (millis() - ultimaLecturaRGB >=
      INTERVALO_RGB) {

    ultimaLecturaRGB = millis();
    leerColor();
  }
}

// ========================================
// MEMORIA DE CASILLAS
// ========================================

bool posicionValida(int x, int y) {

  return x >= 0 &&
         x < MAPA_SIZE &&
         y >= 0 &&
         y < MAPA_SIZE;
}

byte vecesVisitada(int direccion) {

  int nx = posX + dx[direccion];
  int ny = posY + dy[direccion];

  if (!posicionValida(nx, ny)) {
    return 255;
  }

  return visitadas[ny][nx];
}

void registrarCasilla() {

  if (!posicionValida(posX, posY)) {
    return;
  }

  if (visitadas[posY][posX] < 254) {
    visitadas[posY][posX]++;
  }

  Serial.print("POSICION: ");
  Serial.print(posX);
  Serial.print(",");
  Serial.println(posY);
}

void actualizarPosicion() {

  int nx = posX + dx[orientacion];
  int ny = posY + dy[orientacion];

  if (posicionValida(nx, ny)) {

    posX = nx;
    posY = ny;

    registrarCasilla();
  }
}

// ========================================
// GIROS
// ========================================

// Giro pequeno SIN actualizar orientacion.
// Solo se usa durante el escaneo.

void girarPasoDerecha() {

  girarDerecha();
  delay(TIEMPO_GIRO_30);
  detener();
}

void girarPasoIzquierda() {

  girarIzquierda();
  delay(TIEMPO_GIRO_30);
  detener();
}

// Giro completo de 90 grados

void girar90Derecha() {

  girarDerecha();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 1) % 4;
}

void girar90Izquierda() {

  girarIzquierda();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 3) % 4;
}

void girar180() {

  girar90Derecha();
  girar90Derecha();
}

// ========================================
// AVANZAR UNA CASILLA
// ========================================

bool avanzarCasilla() {

  unsigned long inicio = millis();
  unsigned long ultimaRevision = 0;

  avanzar();

  while (millis() - inicio < TIEMPO_CASILLA) {

    unsigned long ahora = millis();

    if (ahora - ultimaRevision >=
        INTERVALO_ULTRASONICO) {

      ultimaRevision = ahora;
      leerUltrasonico();

      if (distancia < 0 ||
          distancia <= DISTANCIA_PARED) {

        detener();

        Serial.println("OBSTACULO O ERROR");

        return false;
      }
    }

    actualizarRGB();
  }

  detener();

  actualizarPosicion();

  return true;
}

// ========================================
// ESCANEO RAPIDO
// ========================================

// Busca una abertura girando en pasos de
// aproximadamente 30 grados.
//
// Si encuentra una abertura antes de 90°,
// termina de girar hasta 90° y confirma.
//
// Si no encuentra salida, regresa a la
// orientacion original.

bool escanearDerecha() {

  Serial.println("BUSCANDO DERECHA");

  int pasos = 0;
  bool aberturaDetectada = false;

  // Hasta 90 grados hacia la derecha
  for (int i = 0; i < 3; i++) {

    girarPasoDerecha();
    pasos++;

    delay(100);

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      aberturaDetectada = true;
      break;
    }
  }

  if (aberturaDetectada) {

    // Completar los 90 grados
    while (pasos < 3) {
      girarPasoDerecha();
      pasos++;
    }

    delay(100);

    // Confirmar frente alineado
    if (espacioLibre(DISTANCIA_ABERTURA)) {

      orientacion = (orientacion + 1) % 4;

      Serial.println("SALIDA DERECHA");
      return true;
    }
  }

  // Regresar exactamente los pasos girados
  for (int i = 0; i < pasos; i++) {
    girarPasoIzquierda();
  }

  detener();
  return false;
}

bool escanearIzquierda() {

  Serial.println("BUSCANDO IZQUIERDA");

  int pasos = 0;
  bool aberturaDetectada = false;

  // Hasta 90 grados hacia la izquierda
  for (int i = 0; i < 3; i++) {

    girarPasoIzquierda();
    pasos++;

    delay(100);

    if (espacioLibre(DISTANCIA_ABERTURA)) {
      aberturaDetectada = true;
      break;
    }
  }

  if (aberturaDetectada) {

    // Completar los 90 grados
    while (pasos < 3) {
      girarPasoIzquierda();
      pasos++;
    }

    delay(100);

    if (espacioLibre(DISTANCIA_ABERTURA)) {

      orientacion = (orientacion + 3) % 4;

      Serial.println("SALIDA IZQUIERDA");
      return true;
    }
  }

  // Regresar a la orientacion inicial
  for (int i = 0; i < pasos; i++) {
    girarPasoDerecha();
  }

  detener();
  return false;
}

// ========================================
// ELEGIR SALIDA
// ========================================

bool buscarSalidaRapida() {

  detener();

  // Primero buscar a la derecha
  if (escanearDerecha()) {
    return true;
  }

  // Si no encuentra, buscar izquierda
  if (escanearIzquierda()) {
    return true;
  }

  // Si ambos lados estan bloqueados,
  // intentar regresar
  Serial.println("BUSCANDO ATRAS");

  girar180();

  if (espacioLibre(DISTANCIA_LIBRE)) {

    Serial.println("RETROCEDIENDO POR OTRA RUTA");
    return true;
  }

  Serial.println("SIN SALIDA SEGURA");
  detener();

  return false;
}

// ========================================
// NAVEGACION PISTA B
// ========================================

void explorarPistaB() {

  actualizarRGB();

  leerUltrasonico();

  // Si no hay lectura, detener
  if (distancia < 0) {

    detener();
    delay(100);
    return;
  }

  // Avanzar si hay camino libre
  // y la siguiente casilla no esta visitada
  if (distancia >= DISTANCIA_LIBRE &&
      vecesVisitada(orientacion) == 0) {

    Serial.println("AVANZANDO");

    avanzarCasilla();
    return;
  }

  // Si encuentra pared o camino visitado,
  // buscar una nueva salida

  detener();

  Serial.println("BUSCANDO NUEVA RUTA");

  if (buscarSalidaRapida()) {

    avanzarCasilla();

  } else {

    detener();
    delay(300);
  }
}

// ========================================
// SETUP
// ========================================

void setup() {

  Serial.begin(9600);

  // Motores
  pinMode(PWMA, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);

  pinMode(PWMB, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  pinMode(STBY, OUTPUT);

  // Sensores
  pinMode(TRIGGER_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  // LEDs
  pinMode(pink_pin, OUTPUT);
  pinMode(orange_pin, OUTPUT);
  pinMode(yellow_pin, OUTPUT);
  pinMode(blue_pin, OUTPUT);

  digitalWrite(TRIGGER_PIN, LOW);
  digitalWrite(STBY, LOW);

  detener();
  apagarLeds();

  // Limpiar memoria
  for (int y = 0; y < MAPA_SIZE; y++) {

    for (int x = 0; x < MAPA_SIZE; x++) {

      visitadas[y][x] = 0;
    }
  }

  registrarCasilla();

  // Inicializar RGB
  Wire.begin();
  colorDisponible = tcs.begin();

  Serial.println(
    colorDisponible ?
    "RGB LISTO" :
    "RGB NO DETECTADO"
  );

  // Activar motores
  digitalWrite(STBY, HIGH);

  Serial.println("PISTA B - BUSQUEDA RAPIDA");
  Serial.println("INICIANDO EN 3 SEGUNDOS");

  delay(3000);
}

// ========================================
// LOOP
// ========================================

void loop() {

  explorarPistaB();
}
