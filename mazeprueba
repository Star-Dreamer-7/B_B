
#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_TCS34725.h>

// ========================================
// ROBOREGOS - PISTA B
// EXPLORACION CON MEMORIA APROXIMADA
// ========================================

// ---------- MOTORES TB6612FNG ----------

const int PWMA = 5;
const int AIN1 = A0;
const int AIN2 = A1;

const int PWMB = 6;
const int BIN1 = A2;
const int BIN2 = A3;

const int STBY = 11;

// ---------- SENSORES ----------

const int TRIGGER_PIN = 2;
const int ECHO_PIN = 4;
const int IR_PIN = 7;

// ---------- LEDS ----------

const int pink_pin = 9;
const int orange_pin = 10;
const int yellow_pin = 3;
const int blue_pin = 12;

// ---------- RGB ----------

Adafruit_TCS34725 tcs(
  TCS34725_INTEGRATIONTIME_60MS,
  TCS34725_GAIN_1X
);

// ========================================
// CONFIGURACION CALIBRADA
// ========================================

const int VELOCIDAD = 210;
const int VELOCIDAD_GIRO = 220;

const bool INVERTIR_IZQUIERDO = true;
const bool INVERTIR_DERECHO = true;

// 30 cm aproximadamente
const unsigned long TIEMPO_CASILLA = 4000;

// Giro aproximado de 90 grados
const unsigned long TIEMPO_GIRO_90 = 2000;

// Distancia de seguridad
const float DISTANCIA_PARED = 15.0;
const float DISTANCIA_LIBRE = 20.0;

// Intervalos
const unsigned long INTERVALO_ULTRASONICO = 60;
const unsigned long INTERVALO_RGB = 500;

// ========================================
// MEMORIA DEL RECORRIDO
// ========================================

// Cuadricula virtual centrada en el robot.
// NO es un mapa cargado previamente.

const int MAPA_SIZE = 15;

byte visitadas[MAPA_SIZE][MAPA_SIZE];

// Posicion inicial aproximada
int posX = MAPA_SIZE / 2;
int posY = MAPA_SIZE / 2;

// Orientacion:
// 0 = NORTE
// 1 = ESTE
// 2 = SUR
// 3 = OESTE

int orientacion = 0;

const int dx[4] = {0, 1, 0, -1};
const int dy[4] = {-1, 0, 1, 0};

// ========================================
// VARIABLES
// ========================================

float distancia = -1;

bool colorDisponible = false;

float rojo = 0;
float verde = 0;
float azul = 0;

String colorDetectado = "SIN LECTURA";

unsigned long ultimaLecturaRGB = 0;

// ========================================
// MOTORES
// ========================================

void moverMotores(int izquierda, int derecha) {

  izquierda = constrain(izquierda, -255, 255);
  derecha = constrain(derecha, -255, 255);

  if (INVERTIR_IZQUIERDO) {
    izquierda = -izquierda;
  }

  if (INVERTIR_DERECHO) {
    derecha = -derecha;
  }

  digitalWrite(AIN1, izquierda > 0 ? HIGH : LOW);
  digitalWrite(AIN2, izquierda < 0 ? HIGH : LOW);

  digitalWrite(BIN1, derecha > 0 ? HIGH : LOW);
  digitalWrite(BIN2, derecha < 0 ? HIGH : LOW);

  analogWrite(PWMA, abs(izquierda));
  analogWrite(PWMB, abs(derecha));
}

void detener() {
  moverMotores(0, 0);
}

void avanzar() {
  moverMotores(VELOCIDAD, VELOCIDAD);
}

void retroceder() {
  moverMotores(-VELOCIDAD, -VELOCIDAD);
}

void girarDerecha() {
  moverMotores(VELOCIDAD_GIRO, -VELOCIDAD_GIRO);
}

void girarIzquierda() {
  moverMotores(-VELOCIDAD_GIRO, VELOCIDAD_GIRO);
}

// ========================================
// ULTRASONICO
// ========================================

void leerUltrasonico() {

  digitalWrite(TRIGGER_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIGGER_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIGGER_PIN, LOW);

  unsigned long tiempo =
    pulseIn(ECHO_PIN, HIGH, 25000UL);

  if (tiempo == 0) {
    distancia = -1;
  } else {
    distancia = tiempo * 0.0343 / 2.0;
  }
}

bool frenteLibre() {

  leerUltrasonico();

  return distancia >= DISTANCIA_LIBRE;
}

// ========================================
// INFRARROJO
// ========================================

bool obstaculoIR() {
  return digitalRead(IR_PIN) == LOW;
}

// ========================================
// LEDS
// ========================================

void apagarLeds() {

  digitalWrite(pink_pin, LOW);
  digitalWrite(orange_pin, LOW);
  digitalWrite(yellow_pin, LOW);
  digitalWrite(blue_pin, LOW);
}

// ========================================
// RGB
// ========================================

void leerColor() {

  if (!colorDisponible) {
    colorDetectado = "RGB NO DISPONIBLE";
    apagarLeds();
    return;
  }

  uint16_t r, g, b, c;

  tcs.getRawData(&r, &g, &b, &c);

  if (c == 0) {
    colorDetectado = "SIN LECTURA";
    apagarLeds();
    return;
  }

  rojo = (float)r / c;
  verde = (float)g / c;
  azul = (float)b / c;

  apagarLeds();

  if (rojo > verde * 1.20 &&
      rojo > azul * 1.10 &&
      azul > verde * 0.85) {

    colorDetectado = "ROSA";
    digitalWrite(pink_pin, HIGH);
  }

  else if (rojo > azul * 1.35 &&
           verde > azul * 1.35 &&
           fabs(rojo - verde) < 0.20 &&
           verde > 0.20) {

    colorDetectado = "AMARILLO";
    digitalWrite(yellow_pin, HIGH);
  }

  else if (rojo > verde * 1.30 &&
           verde > azul * 1.15 &&
           verde > 0.15) {

    colorDetectado = "NARANJA";
    digitalWrite(orange_pin, HIGH);
  }

  else if (azul > rojo * 1.20 &&
           verde > rojo * 1.10) {

    colorDetectado = "CELESTE";
    digitalWrite(blue_pin, HIGH);
  }

  else {
    colorDetectado = "NO IDENTIFICADO";
  }
}

void actualizarRGB() {

  if (millis() - ultimaLecturaRGB >= INTERVALO_RGB) {

    ultimaLecturaRGB = millis();
    leerColor();
  }
}

// ========================================
// MEMORIA
// ========================================

bool posicionValida(int x, int y) {

  return x >= 0 &&
         x < MAPA_SIZE &&
         y >= 0 &&
         y < MAPA_SIZE;
}

byte vecesVisitada(int direccion) {

  int nx = posX + dx[direccion];
  int ny = posY + dy[direccion];

  if (!posicionValida(nx, ny)) {
    return 255;
  }

  return visitadas[ny][nx];
}

void registrarCasilla() {

  if (!posicionValida(posX, posY)) {
    return;
  }

  if (visitadas[posY][posX] < 254) {
    visitadas[posY][posX]++;
  }

  Serial.print("POSICION ESTIMADA: ");
  Serial.print(posX);
  Serial.print(",");
  Serial.println(posY);
}

void actualizarPosicion() {

  int nx = posX + dx[orientacion];
  int ny = posY + dy[orientacion];

  if (posicionValida(nx, ny)) {

    posX = nx;
    posY = ny;

    registrarCasilla();
  }
}

// ========================================
// GIROS DE 90 GRADOS
// ========================================

void girar90Derecha() {

  detener();
  delay(100);

  girarDerecha();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 1) % 4;
}

void girar90Izquierda() {

  detener();
  delay(100);

  girarIzquierda();
  delay(TIEMPO_GIRO_90);
  detener();

  orientacion = (orientacion + 3) % 4;
}

void girar180() {

  girar90Derecha();
  girar90Derecha();
}

// ========================================
// AVANZAR UNA CASILLA APROXIMADA
// ========================================

bool avanzarCasilla() {

  unsigned long inicio = millis();
  unsigned long ultimaRevision = 0;

  avanzar();

  while (millis() - inicio < TIEMPO_CASILLA) {

    unsigned long ahora = millis();

    if (ahora - ultimaRevision >=
        INTERVALO_ULTRASONICO) {

      ultimaRevision = ahora;

      leerUltrasonico();

      // No continuar si no hay lectura
      if (distancia < 0) {

        detener();

        Serial.println("ERROR ULTRASONICO");
        return false;
      }

      // Detener antes de una pared
      if (distancia <= DISTANCIA_PARED) {

        detener();

        Serial.println("OBSTACULO FRONTAL");
        return false;
      }
    }

    actualizarRGB();
  }

  detener();

  // Se completaron los 4 segundos
  actualizarPosicion();

  return true;
}

// ========================================
// EXPLORAR DIRECCIONES
// ========================================

// Revisa el frente, derecha e izquierda.
// Da prioridad a las casillas menos visitadas.
//
// IMPORTANTE:
// Los sensores miran al frente.
// Para revisar un lado, gira el robot.

bool elegirDireccion() {

  int orientacionInicial = orientacion;

  // Direcciones relativas:
  // 0 = frente
  // 1 = derecha
  // 3 = izquierda
  // 2 = atras

  bool libre[4] = {
    false, false, false, false
  };

  byte visitas[4] = {
    255, 255, 255, 255
  };

  // 1. REVISAR FRENTE
  libre[0] = frenteLibre();

  visitas[0] = vecesVisitada(
    orientacionInicial
  );

  // 2. REVISAR DERECHA
  girar90Derecha();

  libre[1] = frenteLibre();

  visitas[1] = vecesVisitada(
    orientacionInicial
  );

  // 3. REVISAR ATRAS
  girar90Derecha();

  libre[2] = frenteLibre();

  visitas[2] = vecesVisitada(
    orientacionInicial
  );

  // 4. REVISAR IZQUIERDA
  girar90Derecha();

  libre[3] = frenteLibre();

  visitas[3] = vecesVisitada(
    orientacionInicial
  );

  // Regresar a la orientacion inicial
  girar90Derecha();

  // ==================================
  // ELEGIR CAMINO MENOS VISITADO
  // ==================================

  int mejorDireccion = -1;
  byte menorVisitas = 255;

  // Prioridad en empates:
  // frente, derecha, izquierda, atras

  int orden[4] = {0, 1, 3, 2};

  for (int i = 0; i < 4; i++) {

    int d = orden[i];

    if (libre[d] && visitas[d] < menorVisitas) {

      menorVisitas = visitas[d];
      mejorDireccion = d;
    }
  }

  if (mejorDireccion == -1) {

    Serial.println("NO HAY CAMINO LIBRE");
    detener();

    return false;
  }

  Serial.print("DIRECCION ELEGIDA: ");
  Serial.println(mejorDireccion);

  // Girar hacia la direccion elegida

  if (mejorDireccion == 1) {
    girar90Derecha();
  }

  else if (mejorDireccion == 3) {
    girar90Izquierda();
  }

  else if (mejorDireccion == 2) {
    girar180();
  }

  return true;
}

// ========================================
// NAVEGACION PISTA B
// ========================================

void explorarPistaB() {

  // Actualizar sensor RGB
  actualizarRGB();

  // Comprobar frente
  leerUltrasonico();

  if (distancia < 0) {

    detener();

    Serial.println("SIN LECTURA");
    delay(100);

    return;
  }

  // Si el frente esta libre y la casilla
  // siguiente no ha sido visitada,
  // avanzar directamente.

  if (distancia >= DISTANCIA_LIBRE &&
      vecesVisitada(orientacion) == 0) {

    Serial.println("AVANZANDO A CASILLA NUEVA");

    avanzarCasilla();

    return;
  }

  // Si hay pared o la siguiente casilla
  // ya fue visitada, explorar opciones.

  detener();

  Serial.println("EXPLORANDO DIRECCIONES");

  if (elegirDireccion()) {

    avanzarCasilla();

  } else {

    detener();
    delay(300);
  }
}

// ========================================
// SETUP
// ========================================

void setup() {

  Serial.begin(9600);

  // Motores
  pinMode(PWMA, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);

  pinMode(PWMB, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  pinMode(STBY, OUTPUT);

  // Sensores
  pinMode(TRIGGER_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(IR_PIN, INPUT);

  // LEDs
  pinMode(pink_pin, OUTPUT);
  pinMode(orange_pin, OUTPUT);
  pinMode(yellow_pin, OUTPUT);
  pinMode(blue_pin, OUTPUT);

  digitalWrite(TRIGGER_PIN, LOW);
  digitalWrite(STBY, LOW);

  detener();
  apagarLeds();

  // Inicializar mapa vacio
  for (int y = 0; y < MAPA_SIZE; y++) {

    for (int x = 0; x < MAPA_SIZE; x++) {

      visitadas[y][x] = 0;
    }
  }

  registrarCasilla();

  // RGB
  Wire.begin();

  colorDisponible = tcs.begin();

  Serial.println(
    colorDisponible ?
    "RGB LISTO" :
    "RGB NO DETECTADO"
  );

  // Activar driver
  digitalWrite(STBY, HIGH);

  Serial.println("PISTA B CON MEMORIA");
  Serial.println("INICIANDO EN 3 SEGUNDOS");

  delay(3000);
}

// ========================================
// LOOP
// ========================================

void loop() {

  explorarPistaB();
}
